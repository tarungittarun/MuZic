<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card, "header" style: a full-width artwork band on
     top, then title/play, the transport row and the progress bar on the
     card body. Plain wrap_content LinearLayout with fixed heights only;
     used automatically when a device drops the fancier banner layout,
     and designed to still read as a big, friendly player rather than a
     squeezed notification row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shade_card_bg"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shade_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shade_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/shade_play_bg"
            android:contentDescription="Play or pause"
            android:padding="12dp"
            android:src="@drawable/ic_play" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Shuffle"
            android:padding="8dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="9dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/shade_icon" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="-10s"
            android:textColor="@color/shade_sub"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="+10s"
            android:textColor="@color/shade_sub"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Next"
            android:padding="9dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/shade_icon" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="8dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shade_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ProgressBar
            android:id="@+id/shade_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:progressDrawable="@drawable/shade_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shade_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/shade_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/shade_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/shade_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
