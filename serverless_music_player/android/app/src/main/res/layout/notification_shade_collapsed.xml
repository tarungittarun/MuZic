<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed shade strip. Sized to stay under Android's collapsed
     custom-view height cap (~64dp): 6dp padding + 44dp controls =
     56dp total, so the title/artist are never clipped. Structure and
     ids are the proven ones shared by both custom card levels; only
     dimensions may change here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shade_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shade_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/shade_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shade_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/shade_sub"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/shade_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Previous"
        android:padding="8dp"
        android:src="@drawable/ic_skip_previous"
        android:tint="@color/shade_icon" />

    <ImageView
        android:id="@+id/shade_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/shade_play_bg"
        android:contentDescription="Play or pause"
        android:padding="11dp"
        android:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/shade_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:contentDescription="Next"
        android:padding="8dp"
        android:src="@drawable/ic_skip_next"
        android:tint="@color/shade_icon" />
</LinearLayout>
