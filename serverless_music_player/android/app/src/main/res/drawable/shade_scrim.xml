<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the lower half of the full-bleed artwork so the title, artist
     and controls stay readable, like the lock-screen media player. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#59000000"
        android:centerY="0.45"
        android:endColor="#E6000000"
        android:startColor="#00000000"
        android:type="linear" />
</shape>
