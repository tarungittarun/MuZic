<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the lock-screen media player:
     full-bleed artwork, gradient scrim, title/artist bottom-left, a big
     pale play button bottom-right and the transport row along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="184dp"
    android:background="@drawable/shade_card_bg">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/shade_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shade_scrim" />

    <ImageView
        android:id="@+id/shade_play"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/shade_play_bg_light"
        android:contentDescription="Play or pause"
        android:padding="15dp"
        android:src="@drawable/ic_play_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/shade_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="76dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shade_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="76dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="#E8FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shade_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Previous"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/shade_seek_back"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="40dp"
                android:text="-10s"
                android:textColor="#CCFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/shade_progress_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/shade_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:progressDrawable="@drawable/shade_progress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shade_elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/shade_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/shade_seek_forward"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="40dp"
                android:text="+10s"
                android:textColor="#CCFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/shade_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Next"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
