<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card, conservative style: full-width artwork band,
     then title/play, the transport row and the progress bar in plain
     flow (no overlaps, no negative margins). Used automatically when a
     device drops the banner layout. Fixed heights totalling ~172dp -
     on the reference device (Motorola Edge 60 Neo, Android 16) custom
     big views materially taller than ~180dp are silently discarded,
     while this size is proven to land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shade_card_bg"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shade_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shade_sub"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/shade_play_bg"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:src="@drawable/ic_play" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="36dp"
            android:layout_height="38dp"
            android:contentDescription="Shuffle"
            android:padding="7dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/shade_icon" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="-10s"
            android:textColor="@color/shade_sub"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="+10s"
            android:textColor="@color/shade_sub"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/shade_icon" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="36dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="7dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shade_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ProgressBar
            android:id="@+id/shade_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:progressDrawable="@drawable/shade_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shade_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/shade_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/shade_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/shade_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
