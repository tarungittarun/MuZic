<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the lock-screen media player:
     full-width artwork band, title/artist with the big pale play
     button, the waveform seekbar, and the shuffle / previous / -10s /
     +10s / next / repeat row on a dark card.

     Deliberately built ONLY from constructs proven to render on the
     reference device (Motorola Edge 60 Neo, Android 16): plain
     LinearLayouts, fixed heights, standard margins - no negative
     margins, no layout_weight/minHeight artwork, no text shadows, no
     overlay containers. Richer variants using those were silently
     dropped by this SystemUI, and one (as a foreground notification)
     crashed the app, so this card stays inside the proven envelope:
     ~179dp tall in total. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shade_card_bg_dark"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/shade_banner_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E8FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shade_play_bg_light"
            android:contentDescription="Play or pause"
            android:padding="12dp"
            android:src="@drawable/ic_play_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shade_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/shade_wave"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:contentDescription="Seek waveform"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shade_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/shade_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:contentDescription="Shuffle"
            android:padding="7dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="-10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="+10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="7dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
</LinearLayout>
