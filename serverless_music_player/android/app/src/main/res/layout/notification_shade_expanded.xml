<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the lock-screen media player:
     the track artwork fills the whole card, and the title/artist, big
     pale play button and waveform seekbar are overlaid on its lower
     half over a dark gradient (shade_scrim), with the shuffle /
     previous / -10s / +10s / next / repeat row on the card body below.

     The waveform is drawn as ten bitmap slices, each its own tap
     target: RemoteViews delivers no drag/scrub events, so tapping the
     waveform jumps playback to that part of the song.

     The root background is transparent on purpose: the card draws
     directly on the system notification surface instead of putting a
     second dark card inside the system's frame (the header, side
     margins and snooze footer are SystemUI chrome that no app can
     remove), so the expanded notification reads as one surface,
     like the lock-screen player and other apps' rich notifications.

     Construct discipline (learned the hard way on the reference
     device, a Motorola Edge 60 Neo on Android 16): plain LinearLayouts
     and core RemoteViews actions only - reflection actions such as
     setColorFilter made SystemUI silently drop the whole card. If
     this card is ever dropped anyway, the ladder falls back to the
     proven conservative card; it can never crash the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/shade_banner_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-124dp"
        android:background="@drawable/shade_scrim"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="26dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shade_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shade_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E8FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/shade_play"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/shade_play_bg_light"
                android:contentDescription="Play or pause"
                android:padding="14dp"
                android:src="@drawable/ic_play_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shade_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/shade_seg_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 5 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 15 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 25 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 35 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 45 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 55 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 65 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 75 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 85 percent"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/shade_seg_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek to 95 percent"
                    android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shade_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/shade_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="36dp"
            android:layout_height="38dp"
            android:contentDescription="Shuffle"
            android:padding="7dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:paddingEnd="6dp"
            android:text="-10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:paddingStart="6dp"
            android:text="+10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="36dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="7dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
</LinearLayout>
