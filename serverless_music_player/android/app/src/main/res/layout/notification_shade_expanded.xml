<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the system media player (full-bleed
     artwork, waveform seekbar, shuffle/previous/play/next/repeat row),
     built with LinearLayout only (device data shows this SystemUI
     discards custom cards containing a FrameLayout).

     The artwork is a flexible (layout_weight) child absorbing whatever
     height the shade allots; the title/play row, waveform seekbar and
     transport row overlay its bottom edge via negative margins, so the
     card is fully utilised at any shade height with no dead space. A
     gradient burned into the banner bitmap keeps the white controls
     readable. The waveform itself is a bitmap generated natively
     (bars + playhead) and refreshed as playback advances. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shade_card_bg"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Album artwork"
        android:minHeight="212dp"
        android:scaleType="centerCrop"
        android:src="@drawable/shade_banner_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginTop="-178dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#E8FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shade_play_bg_light"
            android:contentDescription="Play or pause"
            android:padding="14dp"
            android:src="@drawable/ic_play_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shade_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/shade_wave"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:contentDescription="Seek waveform"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shade_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/shade_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Shuffle"
            android:padding="8dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="-10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:text="+10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="8dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
</LinearLayout>
