<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the lock-screen media player, built
     with LinearLayout only (this app's device data shows SystemUI builds
     that discard custom cards containing a FrameLayout). The artwork
     banner carries a burned-in gradient scrim; the title/artist/play row
     overlays its bottom edge via a negative top margin; transport sits
     below. Total height ~208dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shade_card_bg"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/shade_art"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/shade_banner_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="-58dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#E8FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/shade_play_bg_light"
            android:contentDescription="Play or pause"
            android:padding="13dp"
            android:src="@drawable/ic_play_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Previous"
            android:padding="7dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/shade_icon" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="40dp"
            android:text="-10s"
            android:textColor="@color/shade_sub"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/shade_progress_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/shade_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:progressDrawable="@drawable/shade_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shade_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/shade_sub"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/shade_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shade_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="40dp"
            android:text="+10s"
            android:textColor="@color/shade_sub"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Next"
            android:padding="7dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/shade_icon" />
    </LinearLayout>
</LinearLayout>
