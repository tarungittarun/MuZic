<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card styled after the lock-screen media player:
     full-width artwork with the title/artist and the big round
     play/pause button overlaid at its base over a dark gradient,
     then the waveform seekbar and the shuffle / previous / -10s /
     +10s / next / repeat row on the card body.

     Built only from constructs this device's SystemUI is proven to
     keep: a LinearLayout root and fixed heights. (The previous banner
     used layout_weight + minHeight + a negative margin to overlay
     the title row; on the reference device that card never landed in
     the shade, so the overlay is now a RelativeLayout header block.)
     Total height is ~250dp, in line with the system player's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shade_card_bg_dark"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="148dp">

        <ImageView
            android:id="@+id/shade_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/shade_banner_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shade_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shade_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shade_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowRadius="4"
                    android:textColor="#E8FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/shade_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/shade_play_bg_light"
                android:contentDescription="Play or pause"
                android:padding="15dp"
                android:src="@drawable/ic_play_dark" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/shade_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/shade_wave"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:contentDescription="Seek waveform"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shade_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/shade_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/shade_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Shuffle"
            android:padding="8dp"
            android:src="@drawable/ic_shuffle" />

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="-10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="+10s"
            android:textColor="#E8FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/shade_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Repeat"
            android:padding="8dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
</LinearLayout>
