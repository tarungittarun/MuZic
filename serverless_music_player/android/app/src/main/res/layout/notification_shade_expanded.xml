<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded shade card, "banner" style: artwork banner across the top
     (title/artist and the big pale play button overlaid, like the
     lock-screen player), transport row on the solid card below. The root
     stays a wrap_content LinearLayout: a fixed-height full-bleed
     FrameLayout as the notification root was discarded by some SystemUI
     builds, while this envelope is proven to post. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shade_card_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="148dp">

        <ImageView
            android:id="@+id/shade_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album artwork"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/shade_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shade_scrim" />

        <ImageView
            android:id="@+id/shade_play"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/shade_play_bg_light"
            android:contentDescription="Play or pause"
            android:padding="14dp"
            android:src="@drawable/ic_play_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="74dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/shade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:textColor="#E8FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/shade_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Previous"
            android:padding="7dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/shade_icon" />

        <TextView
            android:id="@+id/shade_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="40dp"
            android:text="-10s"
            android:textColor="@color/shade_sub"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/shade_progress_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/shade_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:progressDrawable="@drawable/shade_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shade_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/shade_sub"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/shade_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shade_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/shade_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:minWidth="40dp"
            android:text="+10s"
            android:textColor="@color/shade_sub"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/shade_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Next"
            android:padding="7dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/shade_icon" />
    </LinearLayout>
</LinearLayout>
